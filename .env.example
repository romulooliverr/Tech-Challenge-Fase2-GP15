# Chave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo (plano gratuito): gemini-3.5-flash | gemini-3.5-flash-lite (limites maiores)
GEMINI_MODEL=gemini-3.5-flash
# "gemini", "ollama" (modelo local) ou "mock" (offline, determinístico — usado nos testes)
LLM_PROVIDER=gemini

# Ollama: `ollama serve` e `ollama pull qwen2.5:14b`
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434

# Mapas: trajeto pelas ruas via OSRM (servidor público, sem chave). "off" = linhas retas.
ROTAS_ROADS=osrm
# OSRM_URL=https://router.project-osrm.org
